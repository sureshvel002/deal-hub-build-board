# Copy to .env.local for local development. On Netlify or Vercel, set the same names in the site's environment variables.
# Both values are on the Supabase dashboard: Project Settings > API (or Connect).
# The anon / publishable key is safe in the browser; row-level security in supabase/schema.sql protects the data.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Set to true only if people may create their own accounts on the sign-in page.
# Leave false to have the manager add accounts in Supabase (Authentication > Users > Add user).
VITE_ALLOW_SIGNUP=false
